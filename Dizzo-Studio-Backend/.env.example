APP_NAME=Dizzo API
ENVIRONMENT=development
# True only for local development: turns on /api/docs, /api/openapi.json and
# the localhost CORS origins. Leave it unset (False) on the server.
DEBUG=True
PORT=8000

# PostgreSQL in Docker. docker-compose builds the backend's DATABASE_URL from
# POSTGRES_PASSWORD, so only set that (hex, e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me-hex-only
# Running the app outside Docker, point it at a database directly:
# DATABASE_URL=postgresql+asyncpg://dizzo_user:<password>@localhost:5432/dizzo_db
# DATABASE_URL=sqlite+aiosqlite:///./dizzo.db

JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=False
COOKIE_DOMAIN=

# Frontend origin(s). For production, set this to your Cloudflare domain,
# for example: https://shop.example.com. With DEBUG the localhost:3000
# origins are added automatically.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Google Identity Services
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Flutter app's Android + iOS OAuth client ids, comma separated
GOOGLE_MOBILE_CLIENT_IDS=

# Telegram Login Widget + Mini App + bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBAPP_URL=http://localhost:3000
BOT_API_URL=http://localhost:8000/api
BOT_TOKEN=

MEDIA_ROOT=./media
MEDIA_URL=/media

# Click Payment (Shop-API / Merchant)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Cloudflare R2 — an API token scoped to Object Read & Write on the bucket.
# R2_PUBLIC_BASE_URL is the bucket's public custom domain (not the
# <account>.r2.cloudflarestorage.com S3 endpoint, which is not public).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# The client IP (rate limits, guest upload quota) is read from
# CF-Connecting-IP / X-Forwarded-For / X-Real-IP only when the request comes
# from a trusted proxy. TRUSTED_PROXIES: comma separated IPs/CIDRs of the
# proxies in front of the app. BEHIND_PROXY=True trusts loopback and private
# networks (the host nginx as the container sees it).
BEHIND_PROXY=False
TRUSTED_PROXIES=

# Uploads one signed-in account may start per hour. Guests are capped per IP
# by GUEST_UPLOADS_PER_HOUR (30); this is the same door for accounts, so
# registering isn't a way past it.
UPLOADS_PER_HOUR=120

# Retention of unused uploads, swept by
# `python -m app.scripts.cleanup_media` (run it daily from cron; --dry-run
# first). Nothing the database still points at is ever deleted, whatever
# its age — these only say when a file nothing uses stops being paid for.
# An upload that never finished (the presigned URL dies after 10 minutes):
PENDING_UPLOAD_TTL_HOURS=24
# A signed-out visitor's picture that no sign-in ever claimed:
GUEST_MEDIA_TTL_DAYS=7
# Anything else nothing references any more (a picture dropped from a
# design, the print files of a cart item that became an order):
ORPHAN_MEDIA_TTL_DAYS=30

# Auth rate limits (in memory, one worker). Only switch off for load tests.
RATE_LIMIT_ENABLED=True
# Seconds a just-rotated refresh token still works (parallel tabs).
REFRESH_REUSE_GRACE_SECONDS=30
